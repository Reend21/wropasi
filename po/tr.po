#: app/src/wropasi/formats/pacman.py:238
msgid "Hunt for a compatible installer across the wild internet"
msgstr "Genel ağ üzerinden sisteminize uygun yükleyiciyi manuel arayın"

#: app/src/wropasi/formats/base.py:238 app/src/wropasi/formats/pacman.py:252
msgid "Wrong Package, Silly!"
msgstr "Yanlış Paket, Şapşal!"

#: app/src/wropasi/formats/base.py:240
#, python-brace-format
msgid ""
"<b>{name}</b> is packaged as <b>{format}</b>, but your system speaks "
"<b>{native}</b>.\n"
"Trying to shove this into your system won't end well."
msgstr ""
"<b>{name}</b> paketi <b>{format}</b> formatını kullanıyor; sisteminiz ise "
"<b>{native}</b> dilinden anlıyor.\n"
"Bu paketi sisteminize zorla sokmaya çalışmak pek iyi sonuçlanmayacaktır."

#: app/src/wropasi/formats/appimage.py:33
msgid "Surprise! This actually runs everywhere."
msgstr "Belki şaşıracaksın ama, bu her yerde çalışır!"

#: app/src/wropasi/formats/appimage.py:35
#, python-brace-format
msgid ""
"<b>{name}</b> is an AppImage. Believe it or not, these portable bundles work "
"on virtually any Linux distro without throwing a tantrum. Instead of "
"launching it raw, you might want to use <b>Gear Lever</b> or "
"<b>AppImageLauncher</b> to integrate it into your desktop."
msgstr ""
"<b>{name}</b> bir AppImage paketidir. İnanması güç ama bu taşınabilir "
"paketler mızmızlanmadan hemen her Linux dağıtımında çalışır. Doğrudan "
"çalıştırmak yerine <b>Gear Lever</b> veya <b>AppImageLauncher</b> kullanarak "
"bu paketi sisteminize entegre edebilirsiniz."

#: app/src/wropasi/formats/appimage.py:41
msgid "All right"
msgstr "Peki"

#: app/src/wropasi/formats/flatpak.py:64 app/src/wropasi/formats/flatpak.py:218
msgid "Install via Terminal (flatpak install)"
msgstr "Terminal ile Kur (flatpak install)"

#: app/src/wropasi/formats/flatpak.py:78
msgid "Flatpak Bundle Ready to Deploy"
msgstr "Flatpak Paketi Kurulabilir"

#: app/src/wropasi/formats/flatpak.py:80
#, python-brace-format
msgid ""
"<b>{name}</b> is an offline Flatpak bundle (.flatpak).\n"
"Flatpak is installed on your system, so you can install this right away."
msgstr ""
"<b>{name}</b> çevrimdışı bir Flatpak uygulama paketidir (.flatpak).\n"
"Sisteminizde Flatpak hazır, doğrudan kurabilirsiniz."

#: app/src/wropasi/formats/flatpak.py:100
#: app/src/wropasi/formats/flatpak.py:254
msgid "Install Flatpak"
msgstr "Flatpak'i Kur"

#: app/src/wropasi/formats/flatpak.py:101
#: app/src/wropasi/formats/flatpak.py:255
msgid "Install the Flatpak runtime through your software center"
msgstr "Yazılım merkeziniz aracılığıyla Flatpak çalışma zamanını kurun"

#: app/src/wropasi/formats/flatpak.py:105
#: app/src/wropasi/formats/flatpak.py:259
msgid "Flatpak Installation"
msgstr "Flatpak Kurulumu"

#: app/src/wropasi/formats/flatpak.py:107
#: app/src/wropasi/formats/flatpak.py:261
msgid ""
"No graphical software store or PackageKit service was found.\n"
"You can install Flatpak via terminal with this command:"
msgstr ""
"Grafiksel yazılım mağazası veya PackageKit servisi bulunamadı.\n"
"Flatpak paketini terminal üzerinden şu komutla kurabilirsiniz:"

#: app/src/wropasi/formats/flatpak.py:143
#: app/src/wropasi/formats/flatpak.py:297
msgid "Flatpak is Missing"
msgstr "Flatpak Kurulu Değil"

#: app/src/wropasi/formats/flatpak.py:145
#, python-brace-format
msgid ""
"<b>{name}</b> is a Flatpak bundle (.flatpak).\n"
"Linux's favorite universal sandbox runtime is not installed on this machine."
msgstr ""
"<b>{name}</b> bir Flatpak paketidir (.flatpak).\n"
"Linux'un gözdesi evrensel paket yöneticisi Flatpak sisteminizde kurulu değil."

#: app/src/wropasi/formats/flatpak.py:232
msgid "Flatpak Reference Ready to Install"
msgstr "Flatpak Referansı Kuruluma Hazır"

#: app/src/wropasi/formats/flatpak.py:234
#, python-brace-format
msgid ""
"<b>{name}</b> is a Flatpak reference file (.flatpakref).\n"
"Flatpak is installed on your system — this file points to an online source "
"and can be installed directly."
msgstr ""
"<b>{name}</b> bir Flatpak referans dosyasıdır (.flatpakref).\n"
"Sisteminizde Flatpak kurulu — bu dosya çevrimiçi bir kaynağa işaret ediyor ve doğrudan kurulabilir."

#: app/src/wropasi/formats/flatpak.py:299
#, python-brace-format
msgid ""
"<b>{name}</b> is a Flatpak reference file (.flatpakref).\n"
"Linux's favorite universal sandbox runtime is not installed on this machine."
msgstr ""
"<b>{name}</b> bir Flatpak referans dosyasıdır (.flatpakref).\n"
"Linux'un gözdesi evrensel paket yöneticisi Flatpak sisteminizde kurulu değil."

#: app/src/wropasi/formats/snap.py:43
msgid "Install via Terminal (snap install)"
msgstr "Terminal ile Kur (snap install)"

#: app/src/wropasi/formats/snap.py:50
msgid ""
"Snap local packages require the --dangerous flag since they are not\n"
"verified by the Snap Store. Run this command in your terminal:"
msgstr ""
"Yerel Snap paketleri Snap Store tarafından doğrulanmadığı için --dangerous\n"
"bayrağını gerektirir. Bu komutu terminalinizde çalıştırın:"

#: app/src/wropasi/formats/snap.py:60
msgid "Snap Package Ready"
msgstr "Snap Paketi Kurulabilir"

#: app/src/wropasi/formats/snap.py:62
#, python-brace-format
msgid ""
"<b>{name}</b> is a Snap package (.snap).\n"
"Snap is installed on your system, so you can install this right away.\n"
"Note: local Snap packages need the <b>--dangerous</b> flag because they are "
"not verified by the Snap Store."
msgstr ""
"<b>{name}</b> bir Snap paketidir (.snap).\n"
"Sisteminizde Snap kurulu olduğu için bu paketi doğrudan kurabilirsiniz.\n"
"Not: Yerel Snap paketleri Snap Store tarafından doğrulanmadığı için <b>--dangerous</b> bayrağına ihtiyaç duyar."

#: app/src/wropasi/formats/snap.py:84
msgid "Install Snap"
msgstr "Snap'i Kur"

#: app/src/wropasi/formats/snap.py:85
msgid "Add Snap package manager support to your system via Software Center"
msgstr "Yazılım Merkezi üzerinden sisteminize Snap paket yöneticisi desteği ekleyin"

#: app/src/wropasi/formats/snap.py:89
msgid "Snap Installation"
msgstr "Snap Kurulumu"

#: app/src/wropasi/formats/snap.py:91
msgid ""
"No graphical software store or PackageKit service was found.\n"
"You can install Snap via terminal with this command:"
msgstr ""
"Grafiksel yazılım mağazası veya PackageKit servisi bulunamadı.\n"
"Snap paket yöneticisini terminal üzerinden şu komutla kurabilirsiniz:"

#: app/src/wropasi/formats/snap.py:127
msgid "Snap is Not Installed"
msgstr "Snap Kurulu Değil"

#: app/src/wropasi/formats/snap.py:129
#, python-brace-format
msgid ""
"<b>{name}</b> is a Snap package (.snap).\n"
"Your system does not have Snap installed to run it.\n"
"Snap is Canonical's universal package format that works across many Linux "
"distributions."
msgstr ""
"<b>{name}</b> bir Snap paketidir (.snap).\n"
"Sisteminizde bu paketi çalıştıracak Snap kurulu değil.\n"
"Snap, Canonical'ın birçok Linux dağıtımında çalışan evrensel paket formatıdır."

#: app/src/wropasi/formats/pacman.py:178
msgid "PKGBUILD Detected — Arch Territory"
msgstr "PKGBUILD Tespit Edildi — Arch Bölgesi"

#: app/src/wropasi/formats/pacman.py:180
#, python-brace-format
msgid ""
"<b>{name}</b> is an Arch Linux PKGBUILD source recipe.\n"
"makepkg is available on your system, so you can build and install it right "
"here."
msgstr ""
"<b>{name}</b> bir Arch Linux PKGBUILD kaynak tarifidir.\n"
"Sisteminizde makepkg mevcut, bu paketi doğrudan burada derleyip kurabilirsiniz."

#: app/src/wropasi/formats/pacman.py:187
msgid "Build & Install via Terminal (makepkg -si)"
msgstr "Terminal ile Derle ve Kur (makepkg -si)"

#: app/src/wropasi/formats/pacman.py:192
msgid "Build & Install"
msgstr "Derle ve Kur"

#: app/src/wropasi/formats/pacman.py:194
msgid "Run this command in your terminal to build and install the package:"
msgstr "Paketi derleyip kurmak için bu komutu terminalinizde çalıştırın:"

#: app/src/wropasi/formats/pacman.py:254
#, python-brace-format
msgid ""
"<b>{name}</b> is an Arch Linux PKGBUILD source recipe, but your system does "
"not use Pacman or makepkg.\n"
"This can only be built on an Arch-based system."
msgstr ""
"<b>{name}</b> bir Arch Linux PKGBUILD kaynak tarifidir ancak sisteminiz "
"Pacman veya makepkg kullanmıyor.\n"
"Bu tarif yalnızca Arch tabanlı bir sistemde derlenebilir."
