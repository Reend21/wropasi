msgid "Convert with alien (Desperate times only)"
msgstr "alien ile Dönüştür (Sadece son çare)"

#: app/src/wropasi/formats/base.py:212
#, python-brace-format
msgid "Mutate the package to {target} format (May work, may summon demons)"
msgstr ""
"Paketi {target} formatına çevirin (Çalışabilir de, sistemi karıştırabilir de)"

#: app/src/wropasi/formats/base.py:223 app/src/wropasi/formats/flatpak.py:128
#: app/src/wropasi/formats/flatpak.py:282 app/src/wropasi/formats/snap.py:112
#: app/src/wropasi/formats/pacman.py:237
msgid "Search the Web Manually"
msgstr "Uyumlu sürümü manuel ara"

#: app/src/wropasi/formats/base.py:224 app/src/wropasi/formats/flatpak.py:129
