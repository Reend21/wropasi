#: app/src/wropasi/formats/flatpak.py:224
msgid "Run this command in your terminal to install the package:"
msgstr "Terminalde şu komutu çalıştırarak paketi doğrudan kurabilirsiniz:"

#: app/src/wropasi/formats/base.py:152
msgid "Miracle! This package actually works on your system."
msgstr "Mucize! Bu paket sisteminizde çalışabilir."

#: app/src/wropasi/formats/base.py:154
#, python-brace-format
msgid ""
"<b>{name}</b> is completely compatible with your system. Go ahead and "
"install it before you change your mind."
msgstr ""
"<b>{name}</b> paketi sisteminizle tamamen uyumludur. Fikrinizi değiştirmeden "
"önce kurun gitsin."

#: app/src/wropasi/formats/base.py:174
msgid "unknown"
msgstr "bilinmiyor"

#: app/src/wropasi/formats/base.py:182 app/src/wropasi/formats/snap.py:101
#: app/src/wropasi/formats/pacman.py:216
msgid "Search on Flathub"
msgstr "Flathub'da Ara"

#: app/src/wropasi/formats/base.py:183 app/src/wropasi/formats/snap.py:102
#: app/src/wropasi/formats/pacman.py:217
msgid "Check the universal sandbox emporium for this app"
msgstr "Evrensel yazılım pazarında paketinizi arayın"

#: app/src/wropasi/formats/base.py:193 app/src/wropasi/formats/flatpak.py:117
#: app/src/wropasi/formats/flatpak.py:271 app/src/wropasi/formats/pacman.py:227
